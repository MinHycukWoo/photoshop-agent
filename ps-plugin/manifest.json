{
  "manifestVersion": 5,
  "id": "com.minhycukwoo.ps-agent",
  "name": "PS Agent",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "26.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "psAgentPanel",
      "label": { "default": "PS Agent" },
      "minimumSize": { "width": 230, "height": 160 },
      "preferredDockedSize": { "width": 260, "height": 200 },
      "preferredFloatingSize": { "width": 260, "height": 200 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" }
  }
}
